# Unity3D gitignore
# Reference: https://github.com/github/gitignore/blob/master/Unity.gitignore

# Logs and profiling data
*.log
*.Log.txt

# Generated binary state
Library/
Obj/
# Builds
Build/
Builds/

# Auto-generated solution files (if not using Version Control for them)
*.csproj.user
*.sln
*.suo

# Unity personal assemblies
*.pidb
*.pdb

# Unity specific
*.apk
*.app
*.o
*.so
*.dll
*.unity3d
*.assets
*.mat
*.prefab
*.unity

# Asset Store packages
# com.unity.package-manager-2019.3+

# Unity 2019+ user settings
# Assets/Editor/DefaultAssemblyDefinitionReferences.json
# Assets/Editor/AssemblyDefinitionObjects.json

#Mac
.DS_Store

#Windows
Thumbs.db
ehthumbs.db
Icon